{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "presentation-studio blueprint",
  "type": "object",
  "required": ["meta", "slides"],
  "additionalProperties": true,
  "properties": {
    "meta": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "event": { "type": "string" },
        "date": { "type": "string" },
        "language": { "type": "string", "default": "en" },
        "rtl": { "type": "boolean", "default": false },
        "aspect": { "type": "string", "enum": ["16:9", "4:3"], "default": "16:9" },
        "durationMinutes": { "type": "number" },
        "audience": {
          "type": "object",
          "properties": {
            "who": { "type": "string" },
            "expertise": { "type": "string", "enum": ["expert", "informed", "lay"] },
            "goal": { "type": "string", "enum": ["decide", "learn", "buy-in", "inspire"] }
          }
        }
      }
    },
    "narrative": {
      "type": "object",
      "properties": {
        "scaffold": { "type": "string" },
        "throughline": { "type": "string" },
        "ask": { "type": "string" }
      }
    },
    "design": {
      "type": "object",
      "properties": {
        "system": { "type": "string" },
        "palette": { "type": "object" },
        "fonts": { "type": "object" },
        "motif": { "type": "string" },
        "gridBackground": { "type": "boolean" }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "slideIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "role"],
        "properties": {
          "id": { "type": "string" },
          "section": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["cover", "stakes", "agenda", "divider", "concept", "evidence",
                     "process", "comparison", "quote", "close", "references", "appendix"]
          },
          "dark": { "type": "boolean" },
          "kicker": { "type": "string" },
          "actionTitle": { "type": "string" },
          "bullets": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": ["text"],
              "properties": {
                "text": { "type": "string" },
                "lead": { "type": "string" },
                "mono": { "type": "boolean" },
                "warm": { "type": "boolean" }
              }
            }
          },
          "exhibit": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["screenshot", "image", "chart", "diagram", "table", "code"] },
              "ref": { "type": "string" },
              "data": {},
              "caption": { "type": "string" },
              "annotate": { "type": "string" },
              "side": { "type": "string", "enum": ["left", "right"] }
            }
          },
          "background": {
            "type": "object",
            "properties": {
              "kind": { "type": "string", "enum": ["grid", "solid", "navy", "photo"] },
              "photo": { "type": "string" },
              "scrim": { "type": "boolean" }
            }
          },
          "engagement": {
            "type": "object",
            "properties": {
              "type": { "type": "string", "enum": ["none", "question", "poll", "activity", "demo", "quiz"] },
              "prompt": { "type": "string" }
            }
          },
          "animation": {
            "type": "object",
            "properties": {
              "transition": { "type": "string", "enum": ["none", "fade", "morph", "push"] },
              "reveals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "step": { "type": "number" },
                    "show": { "type": "array", "items": { "type": "string" } },
                    "zoom": { "type": "string" }
                  }
                }
              },
              "notes": { "type": "string" }
            }
          },
          "speakerNotes": { "type": "string" }
        }
      }
    },
    "navigation": {
      "type": "object",
      "properties": {
        "mode": { "type": "string", "enum": ["linear", "zoom"] },
        "hubSlideId": { "type": "string" },
        "zoomTargets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "path": { "type": "string" },
          "kind": { "type": "string" },
          "credit": { "type": "string" }
        }
      }
    }
  }
}
